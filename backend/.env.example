# Database (Supabase Transaction Pooler recommended)
DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:[YOUR-PASSWORD]@trusted-aphid-184797.upstash.io:6379

# OpenAI
OPENAI_API_KEY=sk-your-key-here

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# NextAuth — declared in Settings but not currently read by any backend
# code (NextAuth runs entirely in the frontend Next.js process). The
# frontend needs its OWN NEXTAUTH_SECRET in frontend/.env.local — these
# two are effectively unused here; kept for forward compatibility only.
NEXTAUTH_SECRET=change-me-to-a-random-secret
NEXTAUTH_URL=http://localhost:3000

# Backend
BACKEND_URL=http://localhost:8000

# CORS (comma-separated origins the frontend is served from)
CORS_ORIGINS=http://localhost:3000

# Comma-separated IPs of trusted reverse proxies. Only set this if the
# backend sits behind one (nginx, load balancer) — X-Forwarded-For is
# otherwise ignored for rate limiting, which is the safe default.
TRUSTED_PROXY_IPS=

# Minutes a Document may sit in status="processing" with no chunks before
# the periodic cleanup_stuck_documents task marks it "failed".
STUCK_DOCUMENT_TIMEOUT_MINUTES=60

# Langfuse (Cloud free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Supabase Storage
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
